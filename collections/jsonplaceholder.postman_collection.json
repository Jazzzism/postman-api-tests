{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "description": "Functional API tests for https://jsonplaceholder.typicode.com covering GET, POST, PUT, DELETE, filtering, request chaining and a negative case.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "List all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const posts = pm.response.json();",
                  "pm.test(\"Returns 100 posts\", () => pm.expect(posts).to.be.an(\"array\").with.lengthOf(100));",
                  "pm.test(\"Every post has the required fields\", () => {",
                  "    posts.forEach(p => pm.expect(p).to.include.all.keys(\"userId\", \"id\", \"title\", \"body\"));",
                  "});",
                  "// Chain: use the first post id in the next request",
                  "pm.collectionVariables.set(\"postId\", posts[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "Get a single post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const post = pm.response.json();",
                  "pm.test(\"Post id matches the requested id\", () => pm.expect(post.id).to.eql(Number(pm.collectionVariables.get(\"postId\"))));",
                  "pm.test(\"Title and body are non-empty strings\", () => {",
                  "    pm.expect(post.title).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(post.body).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "Filter posts by userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const posts = pm.response.json();",
                  "pm.test(\"Returns 10 posts for user 1\", () => pm.expect(posts).to.have.lengthOf(10));",
                  "pm.test(\"All posts belong to user 1\", () => posts.forEach(p => pm.expect(p.userId).to.eql(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const created = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "pm.test(\"Response echoes the title and body sent\", () => {",
                  "    pm.expect(created.title).to.eql(sent.title);",
                  "    pm.expect(created.body).to.eql(sent.body);",
                  "});",
                  "pm.test(\"A new numeric id is returned\", () => pm.expect(created.id).to.be.a(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA test post\",\n  \"body\": \"Created by a Postman test\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const updated = pm.response.json();",
                  "pm.test(\"Title was updated\", () => pm.expect(updated.title).to.eql(\"Updated title\"));",
                  "pm.test(\"Id is unchanged\", () => pm.expect(updated.id).to.eql(Number(pm.collectionVariables.get(\"postId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Response body is an empty object\", () => pm.expect(pm.response.json()).to.eql({}));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get a user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const user = pm.response.json();",
                  "pm.test(\"User id is 1\", () => pm.expect(user.id).to.eql(1));",
                  "pm.test(\"Email has a valid format\", () => pm.expect(user.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/));",
                  "pm.test(\"Address includes geo coordinates\", () => pm.expect(user.address.geo).to.include.all.keys(\"lat\", \"lng\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get comments for a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const comments = pm.response.json();",
                  "pm.test(\"Returns at least one comment\", () => pm.expect(comments).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"All comments belong to post 1\", () => comments.forEach(c => pm.expect(c.postId).to.eql(1)));",
                  "pm.test(\"Every comment has an email\", () => comments.forEach(c => pm.expect(c.email).to.be.a(\"string\").and.include(\"@\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments?postId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments"
              ],
              "query": [
                {
                  "key": "postId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "Get a post that does not exist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Response time is under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "999999"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "postId",
      "value": "1"
    }
  ]
}
